# SignaXAI Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit the real .env file.

# --- Runtime mode ---
# development | production. Controls error detail exposure (see app/main.py)
# and whether a missing JWT_SECRET_KEY is fatal.
ENVIRONMENT=development

# When true, AI/GitHub integration failures silently fall back to mock/rule-based
# results instead of returning an error. Only ever enable this for local demos.
DEMO_MODE=false

# --- Database (MongoDB Atlas) ---
# Get this from Atlas: Database > Connect > Drivers. Requires a database user
# and your current IP (or 0.0.0.0/0 for dev) allowed under Network Access.
# Defaults to a local mongod at localhost:27017 in development if unset;
# required (no default) when ENVIRONMENT=production.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=signaxai
# Used automatically instead of MONGODB_DATABASE whenever ENVIRONMENT=test —
# so a test run can never write into your real database.
MONGODB_TEST_DATABASE=signaxai_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required (no default) when ENVIRONMENT=production.
JWT_SECRET_KEY=replace_me_with_a_random_64_char_hex_string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API with credentials.
# Never use "*" here — it's incompatible with allow_credentials=True.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# --- External services ---
# GitHub Personal Access Token (for repo analysis)
# Create at: https://github.com/settings/tokens — needs public_repo read access only.
GITHUB_TOKEN=

# Groq API Key (for AI task decomposition)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=

# --- SEO / public job pages ---
# This backend's own public origin, used to build canonical URLs, OG tags, and the sitemap.
PUBLIC_BASE_URL=http://localhost:8001

# Where the "Apply" CTA on a public job page sends candidates (the React frontend).
FRONTEND_BASE_URL=http://localhost:5175

# --- SMTP (forgot-password OTP emails) ---
# If left unset, no email is sent — in development the OTP is logged to the
# server console instead so the flow stays testable without real credentials.
# For Gmail: use an App Password (not your account password), smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- GitHub OAuth ("Continue with GitHub" + verified-repo-ownership gate) ---
# Register an OAuth App at https://github.com/settings/developers.
# Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI.
# Separate from GITHUB_TOKEN above — that one is a personal access token used
# server-side for repo analysis; this is the OAuth App used to verify a
# candidate's real GitHub identity before they can submit a proof.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8001/auth/github/callback
GITHUB_OAUTH_STATE_EXPIRE_MINUTES=10

# --- Codeforces (competitive-programming signal) ---
# Create at https://codeforces.com/settings/api — issued as a KEY + SECRET
# pair together (secret shown once, at creation). Public user data (rating,
# solved problems) works without these too; they're only needed to sign a
# request per codeforces.com/apiHelp so it isn't rate-limited as anonymous.
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=
