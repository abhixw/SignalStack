.vscode/
*.swp
*.swo

# Node modules
node_modules/
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Test artifacts
*.pkl
models.txt
output*.txt
verification_results.txt
working_model.txt

